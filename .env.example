# -----------------------------------------------------------------------------
# DevCanvas Environment Configuration
# -----------------------------------------------------------------------------

# Supabase Authentication & Database
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin used in shareable portfolio links.
# Must be the deployed domain people will actually open — never localhost.
# When unset, links fall back to the browser origin (or the production domain
# when that origin is a local/LAN address).
NEXT_PUBLIC_SITE_URL=https://dev-canvas-ia.vercel.app

# Google Gemini AI Integration (Supports single key or multi-key load balancing / rotation)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
# Optional: Multi-key pooling for high concurrency & automated rate-limit failover (1-20)
# GEMINI_API_KEY_1=your-gemini-api-key-1
# GEMINI_API_KEY_2=your-gemini-api-key-2

# GitHub API Access (Optional - boosts rate limits from 60 to 5,000 req/hr for profile enrichment)
# Generate a personal access token at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-personal-access-token

# Contact Form & Email Notifications (Nodemailer)
# Gmail App Password or SMTP credentials for forwarding contact inquiries
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password
